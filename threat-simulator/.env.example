# ── Threat Simulator Configuration ──

# Intervalo entre envío de alertas simuladas
ALERT_INTERVAL_SECONDS=2

# Puerto del simulador
SIMULATOR_PORT=8100

# Endpoint de ingesta del Backend NestJS
NESTJS_BACKEND_URL=http://localhost:3000/api/alerts/ingest

# Modo de envío: 'forward' para enviar al backend, 'log' para solo imprimir en consola
FORWARD_MODE=forward
